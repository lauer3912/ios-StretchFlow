import SwiftUI

struct ContentView: View {
    @EnvironmentObject var themeManager: ThemeManager
    @EnvironmentObject var dataManager: DataManager
    @Environment(\.horizontalSizeClass) private var horizontalSizeClass

    // Launch arg support: -initialTab 0/1/2/3 (Home/Library/Stats/Profile)
    // 用于 simctl 自动化截屏 (iPad 无 tap API)
    @State private var selectedTab: Int = {
        let args = ProcessInfo.processInfo.arguments
        if let i = args.firstIndex(of: "-initialTab"),
           i + 1 < args.count,
           let tab = Int(args[i + 1]),
           (0...3).contains(tab) {
            return tab
        }
        return 0
    }()

    private let tabs: [(name: String, icon: String)] = [
        ("Home", "house.fill"),
        ("Library", "square.grid.2x2.fill"),
        ("Stats", "chart.bar.fill"),
        ("Profile", "person.fill"),
    ]

    @ViewBuilder
    private var detailContent: some View {
        switch selectedTab {
        case 0: HomeView()
        case 1: LibraryView()
        case 2: StatisticsView()
        case 3: ProfileView()
        default: HomeView()
        }
    }

    var body: some View {
        if horizontalSizeClass == .regular {
            // iPad: NavigationView (iOS 15 兼容) — sidebar + detail
            // 修 Apple Guideline 4.0 Design + 2.4.5 iPad-native UI
            NavigationView {
                List(0..<tabs.count, id: \.self, selection: $selectedTab) { idx in
                    Label(tabs[idx].name, systemImage: tabs[idx].icon)
                        .tag(idx)
                        .accessibilityIdentifier("ipad_tab_\(tabs[idx].name.lowercased())")
                }
                .navigationTitle("StretchGoGo")

                detailContent
                    .frame(maxWidth: .infinity, maxHeight: .infinity)
            }
            .navigationViewStyle(.doubleColumn)
        } else {
            // iPhone: TabView (4 tabs bottom)
            TabView(selection: $selectedTab) {
                HomeView()
                    .tabItem { Label("Home", systemImage: "house.fill") }
                    .tag(0)
                    .accessibilityIdentifier("tab_home")
                LibraryView()
                    .tabItem { Label("Library", systemImage: "square.grid.2x2.fill") }
                    .tag(1)
                    .accessibilityIdentifier("tab_library")
                StatisticsView()
                    .tabItem { Label("Stats", systemImage: "chart.bar.fill") }
                    .tag(2)
                    .accessibilityIdentifier("tab_stats")
                ProfileView()
                    .tabItem { Label("Profile", systemImage: "person.fill") }
                    .tag(3)
                    .accessibilityIdentifier("tab_profile")
            }
            .tint(AppColors.lightPrimary)
        }
    }
}
